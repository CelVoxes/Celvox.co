# Copy to .env and adjust. Every value here has a working default, so an
# untouched copy is enough to bring the stack up:
#
#   cp .env.example .env && docker compose up

# --- ports on the host ------------------------------------------------------
FRONTEND_PORT=3000
SERVICE_PORT=3001
R_BACKEND_PORT=5555

# --- local development auth -------------------------------------------------
# 1 = no Firebase project needed; every request is the user below.
# Both flags must agree. Use docker-compose.firebase.yml for real auth.
SEAMLESS_DEV_AUTH=1
VITE_DEV_AUTH=1
SEAMLESS_DEV_USER_EMAIL=dev@localhost

# --- build options ----------------------------------------------------------
# 0 skips the torch/Bridge Python environment: ~10 min and ~1.5GB less to
# build, at the cost of the /bridge-predict endpoint.
WITH_BRIDGE=1

# dev = Vite HMR + tsc on service start. prod = prebuilt bundles.
SERVICE_TARGET=dev
NODE_ENV=development

# --- optional ---------------------------------------------------------------
# Required only by the /ai-report endpoint.
OPENAI_API_KEY=

# Override when reaching the stack from somewhere other than localhost,
# e.g. VITE_API_BASE_URL=http://192.168.1.20:3001/v1
VITE_API_BASE_URL=

# Only needed with docker-compose.firebase.yml.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
